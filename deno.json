{
  "tasks": {
    "build:firefox": "deno bundle -o dist/content.js src/content.js && dx web-ext build",
    "dev": "deno bundle --watch -o dist/content.js src/content.js",
    "start:firefox": "dx web-ext run"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  },
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable", "dom.asynciterable", "deno.ns"]
  }
}
